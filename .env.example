# Aura Voice CX - Environment Configuration (Example)
# Replace placeholder values with your real credentials in your local .env or hosting secret settings.
# NEVER commit your real .env file or API keys to GitHub.

# Server Port
PORT=3000

# Groq Cloud API Key (Get key from https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here

# Groq Models
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_STT_MODEL=whisper-large-v3-turbo
GROQ_TTS_MODEL=canopylabs/orpheus-v1-english

# Optional Node environment
NODE_ENV=development
