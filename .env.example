# Aura Voice CX - Environment Configuration (Example)
# Replace placeholder values with your real credentials in your local .env or Render secret settings.
# NEVER commit your real .env file or API keys to GitHub.

# Server Port (Render automatically supplies PORT in production)
PORT=3000

# Groq Cloud API Key (Get free key from https://console.groq.com/keys)
GROQ_API_KEY=gsk_your_groq_api_key_placeholder

# Optional Node environment
NODE_ENV=development
