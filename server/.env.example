# Aura Voice CX - Backend Server Environment Configuration
# Configure these in your Vercel Backend Project settings under "Environment Variables".
# NEVER commit your production keys to GitHub.

# Server Port (used for local development)
PORT=3000

# Required: Groq Cloud API Key (from https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here

# Optional: Groq LLM & Audio Models (defaults are provided if omitted)
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_STT_MODEL=whisper-large-v3-turbo
GROQ_TTS_MODEL=canopylabs/orpheus-v1-english
GROQ_TTS_VOICE=troy
GROQ_TIMEOUT_MS=10000

# Optional Node Environment
NODE_ENV=production
